# ───────── Gazin URA Intelligence — backend ─────────
# NUNCA versionar o arquivo .env real. Em produção, usar um cofre de segredos.

NODE_ENV=production
PORT=8080
HOST=0.0.0.0
TIME_ZONE=America/Sao_Paulo
DATABASE_URL=postgres://gazin_ura:SENHA@localhost:5432/gazin_ura

# Autenticação corporativa: o proxy de SSO (ex.: oauth2-proxy + Microsoft Entra ID) autentica
# e envia o e-mail do usuário. O backend só aceita requisições com o segredo do proxy.
AUTH_MODE=proxy
AUTH_EMAIL_HEADER=x-forwarded-email
AUTH_NAME_HEADER=x-forwarded-preferred-username
AUTH_PROXY_SECRET=troque-por-um-valor-longo-e-aleatorio
# E-mail do primeiro administrador (criado automaticamente no primeiro acesso).
BOOTSTRAP_ADMIN_EMAIL=

# Genesys Cloud — cliente OAuth Client Credentials com função SOMENTE LEITURA (ver docs/GENESYS_API.md).
# Região da organização Gazin: Leste dos EUA (us-east-1) → mypurecloud.com
GENESYS_REGION_DOMAIN=mypurecloud.com
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_MAX_REQUESTS_PER_MINUTE=120
# Valores de transferType que contam como transferência para atendimento humano (validar com dados reais).
GENESYS_HUMAN_TRANSFER_TYPES=ACD

# Inteligência CX — redação de resumos por IA (OPCIONAL, desligada por padrão).
# Ative somente com autorização formal da Gazin. Apenas agregados são enviados (nunca dados de clientes).
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_PER_USER_PER_HOUR=20

# Agendador de coletas
SCHEDULER_ENABLED=true
SCHEDULER_INCREMENTAL_MINUTES=15
SCHEDULER_DAILY_CLOSE_HOUR=4

# ───────── Somente desenvolvimento ─────────
# AUTH_MODE=dev aceita o cabeçalho X-Dev-User (proibido com NODE_ENV=production).
# GENESYS_API_BASE_URL / GENESYS_LOGIN_BASE_URL apontam para o Genesys SIMULADO (npm run mock:genesys).
