# Copie para server/.env para rodar localmente com o Genesys SIMULADO.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://gazin_ura:dev_only_pw@localhost:5432/gazin_ura
AUTH_MODE=dev
BOOTSTRAP_ADMIN_EMAIL=admin@gazin.com.br
GENESYS_CLIENT_ID=mock-client-id
GENESYS_CLIENT_SECRET=mock-client-secret
GENESYS_API_BASE_URL=http://127.0.0.1:9090
GENESYS_LOGIN_BASE_URL=http://127.0.0.1:9090
SCHEDULER_ENABLED=false
# Redação por IA contra a API FALSA (npm run mock:anthropic):
# AI_ENABLED=true
# ANTHROPIC_API_KEY=teste
# ANTHROPIC_BASE_URL=http://127.0.0.1:9091
