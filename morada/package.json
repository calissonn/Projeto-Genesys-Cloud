{
  "name": "morada",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Morada — simulador de vida, construção e decoração residencial (PWA 3D mobile)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e-smoke.cjs && node tests/e2e-vida.cjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
